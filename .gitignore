# Build artifacts -- regenerated by `pyinstaller`, not source. The .exe
# itself is published as a GitHub Release asset, not committed here.
# (ReleaseKnowledgeCapture.spec IS kept -- it's the build recipe, not
# an artifact.)
build/
dist/

# Python
__pycache__/
*.pyc

# Per-machine config -- deliberately never committed (see client_config.py's
# own docstring). Each install points at its own real server URL.
config.json

# Runtime-generated by server/tunnel_supervisor.py -- a rotating URL and a
# connection log, not source. Committing these would just churn on every
# tunnel restart.
server/tunnel.log
server/current_tunnel_url.txt

# Editor/tool state, not app source
.claude/

# Local browser/preview profiles created by tooling -- never commit
.edge-*/
